# ============================================================================
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
#   make init   (hoặc: cp .env.example .env)
# ============================================================================

# ---------- Airflow ----------
# UID chạy container Airflow. Linux: đặt = `id -u`. Windows/macOS (Docker Desktop): để nguyên 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Secret key chung cho webserver/scheduler (đổi tuỳ ý, chỉ dùng nội bộ local)
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-local-secret
# Port host cho Airflow UI (đổi nếu 8080 đã bị chiếm)
AIRFLOW_WEBSERVER_PORT=8080
# mem_limit cho MỖI container airflow (scheduler + webserver)
AIRFLOW_MEM_LIMIT=2g

# ---------- Postgres (metadata Airflow, chỉ dùng nội bộ compose) ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---------- ClickHouse ----------
# LƯU Ý: nếu đổi CLICKHOUSE_USER thì phải đổi cả tag <fb> trong
# clickhouse/users.d/default-user.xml (quyền named collection cho s3()).
CLICKHOUSE_USER=fb
# BẮT BUỘC đặt — compose sẽ từ chối chạy nếu thiếu
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=fb
# mem_limit container ClickHouse. Xem README mục "RAM tối thiểu".
CLICKHOUSE_MEM_LIMIT=6g
# Giới hạn bộ nhớ 1 query (bytes) — áp cho INSERT đọc Parquet. Tăng nếu OOM ngân sách cho phép.
MAX_MEMORY_USAGE=4000000000
# Số thread insert. GIẢM nếu OOM khi đọc Parquet lớn.
MAX_INSERT_THREADS=4

# ---------- GCP ----------
GCP_PROJECT_ID=chat-gpt-fb449
BQ_DATASET=analytics_352963567
# Location của BQ dataset (GA4 export mặc định là US)
BQ_LOCATION=US
GCS_BUCKET=chat-gpt-android-backup-from-bigquery-table-sufix
# Prefix raw ĐÃ CÓ SẴN trên bucket — dùng cho DAG backfill (use_existing_gcs=true)
GCS_RAW_PREFIX=analytics_352963567/events_intraday
# Prefix nơi EXPORT DATA ghi Parquet staging theo dt=YYYY-MM-DD
GCS_STAGING_PREFIX=staging_raw

# HMAC key của GCS cho ClickHouse s3() — tạo tại:
#   Cloud Storage -> Settings -> Interoperability -> "Create a key for a service account"
# LƯU Ý: key JSON của service account KHÔNG dùng được với s3(). Xem README.
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET=

# ---------- Pipeline ----------
# 's3'  : ClickHouse đọc thẳng GCS qua s3() (cần HMAC key ở trên) — mặc định
# 'file': Airflow tải Parquet về shared volume, ClickHouse đọc qua file() — fallback khi chưa có HMAC
INGEST_STRATEGY=s3
# TTL cho fb.events_raw theo _dt. 0 = giữ vĩnh viễn (mặc định — phase này events_raw là đích cuối).
RAW_TTL_DAYS=0
# Xoá Parquet staging (GCS + local) sau khi ingest thành công
CLEANUP_STAGING=true
TZ=Asia/Ho_Chi_Minh
